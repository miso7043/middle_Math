  {"id": "D18", "grade": 2, "unit": "삼각형과 사각형의 성질", "page": 5, "title": "내심", "body": "세 내각의 이등분선의 교점", "lines": []},
  {"id": "T23", "grade": 2, "unit": "삼각형과 사각형의 성질", "page": 5, "title": "내심의 성질", "body": "세 변에서 같은 거리에 있고, 삼각형의 넓이는 S = 1/2r(a+b+c) (r은 내접원의 반지름)", "lines": []},
  {"id": "D19", "grade": 2, "unit": "삼각형과 사각형의 성질", "page": 5, "title": "평행사변형", "body": "두 쌍의 대변이 각각 평행한 사각형", "lines": []},
  {"id": "T24", "grade": 2, "unit": "삼각형과 사각형의 성질", "page": 5, "title": "평행사변형의 성질", "body": "대변의 길이가 같고, 대각의 크기가 같고, 두 대각선이 서로를 이등분합니다.", "lines": []},
  {"id": "D20", "grade": 2, "unit": "삼각형과 사각형의 성질", "page": 5, "title": "특수한 사각형", "body": "직사각형, 마름모, 정사각형", "lines": []},
  {"id": "T25", "grade": 2, "unit": "삼각형과 사각형의 성질", "page": 5, "title": "특수한 사각형의 대각선", "body": "직사각형은 대각선의 길이가 같고, 마름모는 대각선이 수직이며, 정사각형은 둘 다 만족합니다.", "lines": []},
  {"id": "D21", "grade": 2, "unit": "도형의 닮음", "page": 5, "title": "닮음", "body": "한 도형을 일정한 비율로 확대 또는 축소하여 다른 도형과 합동이 되는 관계", "lines": []},
  {"id": "T26", "grade": 2, "unit": "도형의 닮음", "page": 5, "title": "삼각형의 닮음 조건", "body": "SSS 비례, SAS 비례, AA", "lines": []},
  {"id": "T27", "grade": 2, "unit": "도형의 닮음", "page": 6, "title": "평행선과 선분의 길이의 비", "body": "△ABC에서 DE∥BC이면 AD : AB = AE : AC = DE : BC", "lines": [], "note": "D는 AB 위, E는 AC 위에 있다."},
  {"id": "D22", "grade": 2, "unit": "도형의 닮음", "page": 6, "title": "무게중심", "body": "세 중선의 교점", "lines": []},
  {"id": "T28", "grade": 2, "unit": "도형의 닮음", "page": 6, "title": "무게중심의 성질", "body": "각 중선을 꼭짓점으로부터 2 : 1로 나눕니다.", "lines": []},
  {"id": "T29", "grade": 2, "unit": "도형의 닮음", "page": 6, "title": "닮음비와 넓이비·부피비", "body": "닮음비가 m : n이면 넓이비는 m² : n², 부피비는 m³ : n³", "lines": []},
  {"id": "T30", "grade": 2, "unit": "피타고라스 정리", "page": 7, "title": "피타고라스 정리", "body": "직각삼각형에서 a² + b² = c² (c는 빗변)", "lines": []},
  {"id": "T31", "grade": 2, "unit": "피타고라스 정리", "page": 7, "title": "피타고라스 정리의 역", "body": "세 변이 a² + b² = c²을 만족하면 직각삼각형입니다.", "lines": []},
  {"id": "D23", "grade": 2, "unit": "확률", "page": 7, "title": "확률", "body": "P(A) = (A가 일어나는 경우의 수) / (모든 경우의 수)", "lines": [], "note": "이 식은 모든 결과가 같은 가능성을 갖는 유한 표본공간에 적용한다."},
  {"id": "T32", "grade": 2, "unit": "확률", "page": 7, "title": "여사건의 확률", "body": "P(A) + P(Aᶜ) = 1", "lines": []},
  {"id": "T33", "grade": 2, "unit": "확률", "page": 7, "title": "합의 법칙·곱의 법칙", "body": "'또는'이면 더하고, '그리고'이면 곱합니다.", "lines": [], "note": "경우의 수를 더할 때는 서로 겹치지 않는 경우를 센다. 각 첫 단계 선택마다 다음 단계의 선택 수가 같으면 두 단계의 경우의 수를 곱한다."}
